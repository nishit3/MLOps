# User id Airflow runs as inside the containers. 50000 is right for Windows/macOS;
# on Linux set it to the output of `id -u` so files in logs/ and working_data/ are yours.
AIRFLOW_UID=50000

# Login for the Airflow UI at http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
