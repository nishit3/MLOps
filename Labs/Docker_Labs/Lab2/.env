# ---- Runtime configuration read by docker-compose.yml ----
# Change values here instead of editing code or YAML.

# Image tag applied to both built images
IMAGE_TAG=1.0

# Port on YOUR machine -> port inside the serving container
HOST_PORT=8080
PORT=8000

# Training configuration (passed into the trainer container)
MODEL_VERSION=1.0.0
EPOCHS=200
# Candidate architectures: hidden-layer sizes, ';' separates candidates
MODEL_CANDIDATES=16;32,16;64,32,16
DROPOUT=0.1
# Quality gate: training exits non-zero (and serving never starts) below this test accuracy
MIN_ACCURACY=0.90
