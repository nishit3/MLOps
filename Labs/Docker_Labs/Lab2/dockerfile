# syntax=docker/dockerfile:1
#
# Multi-stage build for the penguin classifier.
#
#   base             slim Python + non-root user + empty /models owned by that user
#   tf_base          + TensorFlow (one shared layer reused by BOTH images below)
#   model_training   + pandas/sklearn + dataset + training code   (compose "trainer")
#   serving_runtime  + Flask/gunicorn + API code, NO model inside  (compose "serving")
#   trained          runs training at build time                   (standalone build only)
#   serving          serving_runtime + model baked in              (default target)
#
# Compose builds only model_training and serving_runtime, and moves the model
# between them through a named volume. A plain `docker build .` builds the
# last stage, giving one self-contained image with the model baked in.

ARG PYTHON_VERSION=3.10

# ---------------------------------------------------------------------------
FROM python:${PYTHON_VERSION}-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TF_CPP_MIN_LOG_LEVEL=2
# /models is created and chowned here so a new named volume mounted on it
# inherits appuser ownership (Docker copies the image's directory ownership
# into an empty volume on first mount); otherwise the volume is root-owned
# and the non-root trainer can't write to it.
RUN useradd --create-home --uid 10001 appuser \
 && mkdir -p /models \
 && chown appuser:appuser /models
WORKDIR /app

# ---------------------------------------------------------------------------
FROM base AS tf_base
# Requirements are copied before any source code, so editing code never
# invalidates this (very large) layer.
COPY requirements/tf.txt requirements/tf.txt
RUN pip install -r requirements/tf.txt

# ---------------------------------------------------------------------------
FROM tf_base AS model_training
COPY requirements/train.txt requirements/train.txt
RUN pip install -r requirements/train.txt
COPY data/penguins.csv data/penguins.csv
COPY src/model_training.py .

# Build-time defaults (ARG) become runtime defaults (ENV); compose/.env can
# still override any of them at `docker compose up` without rebuilding.
ARG EPOCHS=200
ARG MODEL_CANDIDATES="16;32,16;64,32,16"
ARG DROPOUT=0.1
ARG MODEL_VERSION=1.0.0
ARG MIN_ACCURACY=0.90
ENV EPOCHS=${EPOCHS} \
    MODEL_CANDIDATES=${MODEL_CANDIDATES} \
    DROPOUT=${DROPOUT} \
    MODEL_VERSION=${MODEL_VERSION} \
    MIN_ACCURACY=${MIN_ACCURACY} \
    DATA_PATH=/app/data/penguins.csv \
    OUTPUT_DIR=/models

USER appuser
CMD ["python", "model_training.py"]

# ---------------------------------------------------------------------------
FROM tf_base AS serving_runtime
COPY requirements/serve.txt requirements/serve.txt
RUN pip install -r requirements/serve.txt
COPY src/main.py src/healthcheck.py ./
COPY src/templates/ templates/
ENV PORT=8000 \
    MODEL_DIR=/models
USER appuser
EXPOSE 8000
# Model loading takes a while on first start, hence the generous start period.
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=5 \
  CMD ["python", "healthcheck.py"]
# Production WSGI server instead of Flask's debug server. `exec` makes
# gunicorn PID 1 so it receives `docker stop` signals directly.
CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT} --workers 1 --threads 4 --timeout 120 main:app"]

# ---------------------------------------------------------------------------
FROM model_training AS trained
RUN python model_training.py

# ---------------------------------------------------------------------------
FROM serving_runtime AS serving
COPY --from=trained --chown=appuser:appuser /models /models
